# --- Supabase project (same project as your main bookkeeping app) ---

# Project URL and publishable key — used for admin login (Supabase Auth)
# and for validating the logged-in user's token server-side.
# Find these in Supabase Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Secret key — SERVER-SIDE ONLY, never exposed to the browser.
# Used to read subscriber/subscription metrics regardless of RLS policies
# written for the main app. Keep this secret. Do not prefix with NEXT_PUBLIC_.
# Find it in Supabase Dashboard > Project Settings > API Keys > Secret keys
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# --- Marketing: GA4 + Search Console (optional) ---
# See docs/marketing-setup.md for the full setup walkthrough.
# Leave these blank and the Marketing section just shows a "not
# connected yet" notice — nothing else on the dashboard is affected.

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GA4_PROPERTY_ID=
SEARCH_CONSOLE_SITE_URL=

# --- Dashboard access control ---

# Comma-separated list of email addresses (must match an existing
# auth.users account in this Supabase project) allowed to log into
# this dashboard. Anyone else who signs in will be signed out immediately.
ALLOWED_ADMIN_EMAILS=you@example.com


# Optional: real monthly prices per plan (lowercase keys matching
# user_subscriptions.plan). Defaults are Pro $9 / Pro Plus $15.
# PLAN_PRICES={"free":0,"pro":9,"pro plus":15}

# Optional: hide test accounts from every number on the dashboard.
# Comma-separated emails or * patterns (case-insensitive).
# EXCLUDED_EMAILS=scott+test@yopie.ca,*@mytestdomain.com

# ---- SEO tab (all free) ----
# Site to audit. If omitted, derived from SEARCH_CONSOLE_SITE_URL.
# SEO_SITE_URL=https://northbooks.ca
# Max pages the site-audit crawler visits (default 150, max 1000).
# SEO_CRAWL_MAX_PAGES=150
# Words that mark a search query as "branded" (comma-separated).
# SEO_BRAND_TERMS=northbooks,north books
# Optional Google PageSpeed API key (free) — avoids shared-quota rate limits.
# PAGESPEED_API_KEY=
# Optional Bing Webmaster API key — enables the Backlinks tab.
# BING_WEBMASTER_API_KEY=
# BING_SITE_URL=https://northbooks.ca

# ---- Helcim (payments) ----
# Helcim → All Tools → Integrations → API Access Configuration. Read-only
# access to Customers, Payment Plans/Recurring and Transaction Processing.
# HELCIM_API_TOKEN=

# ---- Goals, trends & scheduling ----
# MRR_GOAL=1000
# Timezone used to decide what "today" is for daily snapshots.
# DASHBOARD_TZ=America/Toronto
# Secret for GET /api/cron/snapshot (Vercel Cron sends it automatically when
# set as the CRON_SECRET env var in your Vercel project).
# CRON_SECRET=

# ---- Growth tab ----
# Terms searched on Hacker News / Reddit (default: SEO_BRAND_TERMS over 3 chars).
# MENTION_TERMS=northbooks,north books
# Google Alerts → "Deliver to: RSS feed" → paste the feed URL(s), comma-separated.
# GOOGLE_ALERTS_RSS=

# ---- CRM ----
# Name used to sign the "Reach out" email templates.
# OUTREACH_SENDER_NAME=Scott

# ---- Operations: uptime / SSL / domain monitor, alerts, daily digest ----
# URLs to watch (comma-separated). Defaults to SEO_SITE_URL. Add your app too.
MONITOR_URLS=https://northbooks.ca,https://northbooks.ca/dashboard
# Extra registrable domains to track for renewal (the ones in MONITOR_URLS are automatic).
MONITOR_DOMAINS=
# Some registries (.ca) don't publish an expiry via RDAP. Set it by hand: domain=YYYY-MM-DD,domain2=YYYY-MM-DD
MONITOR_DOMAIN_EXPIRY=
# Alert when SSL / domain is this many days from expiring (alerts escalate at 21/14/7/3/1/0 and 60/30/14/7/1/0).
ALERT_SSL_DAYS=21
ALERT_DOMAIN_DAYS=45
# Channels (use either or both; with neither, alerts are only logged on the Ops tab)
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
# Set to false to keep subscriber names/emails out of Slack/email (digest shows "user ab12cd" instead)
ALERT_INCLUDE_PII=true
# Digest header name
SITE_NAME=NorthBooks
